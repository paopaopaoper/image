# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session (JWT signing secret, generate with: openssl rand -base64 32)
SESSION_SECRET=

# Cron job secret (protect /api/cron/process endpoint)
CRON_SECRET=

# 豆包 Seedream 图像生成 (火山引擎 Ark API)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_SIZE=2K

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/graduation_art

# Redis (cache / rate-limit / session store)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible: AWS S3 / Alibaba OSS / Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# SMS OTP provider (Alibaba Cloud SMS / Tencent Cloud SMS)
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# Quota and anti-abuse
FREE_DAILY_GENERATIONS=3
OTP_COOLDOWN_SECONDS=60
GENERATION_COOLDOWN_SECONDS=20
MAX_UPLOAD_MB=12

# Payments are disabled until merchant setup is complete
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_APP_ID=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=

# 图像模型提供商路由 (seedream | gpt-image2)
IMAGE_MODEL_PROVIDER=seedream

# GPT Image 2 (Aihubmix 中转)
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
GPT_IMAGE_MODEL=gpt-image-2
